[0.219, "o", "apiVersion: gateway.networking.k8s.io/v1beta1\r\nkind: HTTPRoute\r\nmetadata:\r\n  name: api\r\n  labels:\r\n    app.kubernetes.io/name: api\r\nspec:\r\n  parentRefs:\r\n    - name: api\r\n      group: gateway.networking.k8s.io\r\n      port: 80\r\n  rules:\r\n    - backendRefs:\r\n        - name: api\r\n          group: \"\"\r\n          port: 80\r\n      filters:\r\n        - type: RequestHeaderModifier\r\n          requestHeaderModifier: {}\r\n      matches:\r\n        - path:\r\n            type: PathPrefix\r\n            value: /\r\n      sessionPersistence:\r\n        type: Cookie\r\n"]
