[0.204, "o", "apiVersion: apps/v1\r\nkind: Deployment\r\nmetadata:\r\n  name: web\r\n  labels:\r\n    app.kubernetes.io/name: web\r\nspec:\r\n  replicas: 3\r\n  selector:\r\n    matchLabels:\r\n      app.kubernetes.io/name: web\r\n  strategy:\r\n    type: RollingUpdate\r\n  template:\r\n    metadata:\r\n      labels:\r\n        app.kubernetes.io/name: web\r\n    spec:\r\n      containers:\r\n        - name: web\r\n          image: \"myapp:v2\"\r\n          ports:\r\n            - containerPort: 80\r\n          resources:\r\n            limits:\r\n              cpu: \"500m\"\r\n              memory: \"256Mi\"\r\n            requests:\r\n              cpu: \"250m\"\r\n              memory: \"128Mi\"\r\n"]
